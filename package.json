{
  "name": "@agentorg/plugin-unique-cwd",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "esbuild ./src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "test:binary": "npm run build && ORG_BINARY=../agentorg/dist/agentorg node --import tsx --test tests/binary-loading.test.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.0.0",
    "agent-organization": "file:../agentorg",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
